# ---- Data (drop the organisers' files into DATA_DIR, or point to each file) ----
DATA_DIR=data/synthetic
# PRODUCTS_PATH=data/challenge/products.csv
# CUSTOMERS_PATH=data/challenge/train.csv          # the customer profile dataset named "train"
# INTERACTIONS_PATH=data/challenge/interactions.csv
# RECOMMENDATIONS_PATH=data/challenge/recommendations.csv   # team-defined recommender output
DEMO_DATE=2026-04-01
CURRENCY=DEMO_UNITS
RUNTIME_DIR=runtime

# ---- AWS ----
AWS_REGION=us-east-1
# BEDROCK_REGION=us-east-1                          # if Bedrock lives in another region than the app
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-pro-v1:0
# SUMMARY_MODEL_ID=us.amazon.nova-lite-v1:0         # cheaper model for memory summaries (optional)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500

# ---- Voice ----
STT_PROVIDER=auto              # auto|transcribe|browser
TRANSCRIBE_LANGUAGE=en-US
TTS_PROVIDER=polly             # polly|browser
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# ---- Memory ----
MAX_HISTORY_MESSAGES=40
KEEP_RECENT_MESSAGES=16

SHOW_SAMPLE_IDS=true           # show demo IDs on the first page (set false for judging if preferred)
